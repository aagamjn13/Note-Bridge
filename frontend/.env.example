# ==============================================================================
# Note-Bridge Frontend Environment Variables
# ==============================================================================

# URL of the deployed Express backend (no trailing slash)
# Local development: http://localhost:5000
# Production on Render: https://<your-backend-web-service>.onrender.com
VITE_REACT_HOST=http://localhost:5000

# Firebase Client SDK Configuration (Firebase Console -> Project Settings -> General -> Your Apps)
VITE_REACT_FIREBASE_API_KEY=your-api-key
VITE_REACT_FIREBASE_AUTHDOMAIN=your-project.firebaseapp.com
VITE_REACT_FIREBASE_PROJECTID=your-project-id
VITE_REACT_FIREBASE_STORAGEBUCKET=note-bridge-app.firebasestorage.app
VITE_REACT_FIREBASE_MESSAGINGSENDERID=your-messaging-sender-id
VITE_REACT_FIREBASE_APIID=your-app-id
VITE_REACT_FIREBASE_MEASUREMENTID=your-measurement-id
