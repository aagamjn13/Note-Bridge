# URL of the Express backend (no trailing slash)
VITE_REACT_HOST=http://localhost:5000

# Firebase web app configuration (Firebase Console -> Project settings -> Your apps)
VITE_REACT_FIREBASE_API_KEY=your-api-key
VITE_REACT_FIREBASE_AUTHDOMAIN=your-project.firebaseapp.com
VITE_REACT_FIREBASE_PROJECTID=your-project-id
VITE_REACT_FIREBASE_STORAGEBUCKET=your-project.appspot.com
VITE_REACT_FIREBASE_MESSAGINGSENDERID=your-messaging-sender-id
VITE_REACT_FIREBASE_APIID=your-app-id
VITE_REACT_FIREBASE_MEASUREMENTID=your-measurement-id
