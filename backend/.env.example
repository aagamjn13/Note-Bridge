# ==============================================================================
# Note-Bridge Backend Environment Variables
# ==============================================================================

# Port the Express server listens on (Render automatically assigns PORT)
PORT=5000

# MongoDB connection string
# Local / Embedded Docker: mongodb://127.0.0.1:27017/note-bridge
# Production with MongoDB Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/note-bridge?retryWrites=true&w=majority
MONGODB_URL=mongodb://127.0.0.1:27017/note-bridge

# Secret used to sign and verify JSON Web Tokens (use a long random 64-char string in production)
JWT_MESSAGE=replace-with-a-secure-random-secret

# Google Gemini API key used by /api/ai/summarize
GEMINI_API_KEY=your-gemini-api-key

# Frontend URL for CORS allowlist (e.g. https://note-bridge.onrender.com)
# Defaults to '*' if omitted or set to '*'
CLIENT_URL=http://localhost:5173

# Firebase Storage bucket name
FIREBASE_STORAGE_BUCKET=note-bridge-app.firebasestorage.app

# Firebase Admin credentials for recursive folder deletion.
# In production on Render, provide the service account JSON (or base64-encoded JSON).
FIREBASE_SERVICE_ACCOUNT=
