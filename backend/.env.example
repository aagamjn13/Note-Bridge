# Port the Express server listens on
PORT=5000

# MongoDB connection string
MONGODB_URL=mongodb://127.0.0.1:27017/note-bridge

# Secret used to sign JWTs - use a long random value outside local development
JWT_MESSAGE=replace-with-a-long-random-secret

# Google Gemini API key used by /api/ai
GEMINI_API_KEY=your-gemini-api-key

# Firebase Admin credentials for deleting storage folders.
# Provide the service account JSON (or base64-encoded JSON) on Render.
FIREBASE_SERVICE_ACCOUNT=

# Firebase Storage bucket used by the backend
FIREBASE_STORAGE_BUCKET=note-bridge-app.firebasestorage.app
